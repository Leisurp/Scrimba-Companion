{
  "name": "scrimba-companion",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-keep-awake": "~58.0.3",
    "expo-screen-orientation": "~58.0.4",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-expo": "~58.0.14",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "build:injected": "node scripts/build-injected.mjs",
    "check:injected": "node scripts/build-injected.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:live": "playwright test --config e2e/playwright.live.config.ts",
    "test:android": "node scripts/android-device-test.mjs",
    "verify": "npm run check:injected && npm run typecheck && npm run lint && npm test",
    "doctor": "expo-doctor"
  },
  "private": true,
  "description": "Unofficial open-source mobile companion that makes Scrimba interactive screencasts usable on phones.",
  "license": "MIT",
  "jest": {
    "projects": [
      {
        "displayName": "native",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.ts?(x)",
          "<rootDir>/tests/components/**/*.test.ts?(x)"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/e2e/",
          "/.toolchain/",
          "/android/",
          "/ios/"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/.toolchain/",
          "<rootDir>/android/",
          "<rootDir>/ios/"
        ],
        "setupFiles": [
          "<rootDir>/jest.setup.js"
        ]
      },
      {
        "displayName": "page-runtime",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/tests/injected/**/*.test.ts"
        ],
        "transform": {
          "^.+.[jt]sx?$": "<rootDir>/tests/esbuild-jest-transform.js"
        },
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/e2e/",
          "/.toolchain/",
          "/android/",
          "/ios/"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/.toolchain/",
          "<rootDir>/android/",
          "<rootDir>/ios/"
        ]
      }
    ]
  }
}
